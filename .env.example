QWEN_API_KEY=
QWEN_BASE_URL=https://token-plan.maas.qianwenaiapi.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
TAVILY_API_KEY=
FORECASTLAB_DATA_DIR=./data
FORECASTLAB_MAX_CALLS=18
FORECASTLAB_MAX_SECONDS=300
FORECASTLAB_LIVE_CUTOFF_GRACE_SECONDS=900
FORECASTLAB_MODEL_TEMPERATURE=0

# Research-only independent semantic entailment judge.
# Use a different provider/model family from the Agent 2 generator for final calibration.
ENTAILMENT_JUDGE_API_KEY=
ENTAILMENT_JUDGE_BASE_URL=
ENTAILMENT_JUDGE_MODEL=

# Optional research-only multilingual NLI baseline. torch/transformers are NOT core dependencies.
ENTAILMENT_NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
ENTAILMENT_LOCAL_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
