# Model backend: auto | qwen | deepseek | vllm_mt
FORECASTLAB_MODEL_PROVIDER=auto

# Qwen-compatible cloud backend (used first in auto mode when QWEN_API_KEY is set)
QWEN_API_KEY=
QWEN_BASE_URL=https://token-plan.maas.qianwenaiapi.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash

# DeepSeek-compatible cloud backend (fallback in auto mode)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Moore Threads vLLM-MT OpenAI-compatible endpoint.
# Keep vLLM bound to 127.0.0.1 on the GPU server and use an SSH tunnel from the ForecastLab host.
VLLM_MT_BASE_URL=http://127.0.0.1:18014/v1
VLLM_MT_MODEL=Model
VLLM_MT_API_KEY=
VLLM_MT_TIMEOUT=180

TAVILY_API_KEY=
FORECASTLAB_DATA_DIR=./data
FORECASTLAB_MAX_CALLS=18
FORECASTLAB_MAX_SECONDS=300
