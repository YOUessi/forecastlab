QWEN_API_KEY=
QWEN_BASE_URL=https://token-plan.maas.qianwenaiapi.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
TAVILY_API_KEY=
FORECASTLAB_DATA_DIR=./data
FORECASTLAB_MAX_CALLS=18
FORECASTLAB_MAX_SECONDS=300

# Preferred search provider; store secrets only in server .env
BRAVE_SEARCH_API_KEY=
# Optional search-only proxy, independent of local model requests
FORECASTLAB_SEARCH_PROXY=

# Opt in for Qwen reasoning; reserve sufficient output tokens and request time.
FORECASTLAB_ENABLE_THINKING=false
